# Supabase Configuration (Database & State Persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Worker Secrets (Backend only - Never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# Primary Live Market Data: Angel One SmartAPI
ANGEL_ONE_API_KEY=your-angel-api-key
ANGEL_ONE_CLIENT_CODE=your-client-code
ANGEL_ONE_PIN=your-pin
ANGEL_ONE_TOTP_SECRET=your-totp-secret

# Fallback Market Data: Groww Trade API (Optional)
# GROWW_API_KEY=your-groww-api-key
# GROWW_API_SECRET=your-groww-api-secret
# GROWW_ACCESS_TOKEN=your-groww-token
